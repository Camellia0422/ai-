rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Path Variable Hardening & Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Admin check - strictly look up specialized admins collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.role in ['user', 'admin']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'userId', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.userId == request.auth.uid
        && data.createdAt == request.time;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'taskType', 'status', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.taskType in ['text_to_video', 'image_to_video', 'reference_video']
        && data.status in ['created', 'queued', 'validating', 'submitted', 'processing', 'success', 'failed', 'refunded', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. Master Gate & 4. Tiered Identity
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
                    && incoming().updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description'])
                    && incoming().name.size() <= 100;
      allow delete: if isOwner(existing().userId);
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(taskId) && isValidTask(incoming()) 
                    && incoming().status == 'created'
                    && incoming().createdAt == request.time;
      
      // 4. Action-Based Update Pattern & 7. Terminal State Locking
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && existing().status != 'success' && existing().status != 'failed' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'negativePrompt', 'updatedAt'])
         && incoming().updatedAt == request.time) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progress', 'finalCost', 'errorMessage', 'updatedAt'])
         && incoming().updatedAt == request.time)
      );
    }

    match /assets/{assetId} {
      allow get: if isSignedIn() && (exists(/databases/$(database)/documents/tasks/$(resource.data.taskId)) && 
                    get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()); // Note: needs userId in asset or lookup
      allow create: if isVerified() && isValidId(assetId) && incoming().taskId is string;
      allow delete: if isAdmin();
    }
    
    // Explicit Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
